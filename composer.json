{
    "name": "jw-1980/pluck",
    "description": "Shared spider fetch primitives (source drivers, polite fetching, guards, FlareSolverr client) for NutriCompare and watvindenwijvan.nl",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.10 || ^8.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "psr/simple-cache": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Pluck\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "bin": [
        "bin/pluck"
    ],
    "autoload-dev": {
        "psr-4": {
            "Pluck\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
