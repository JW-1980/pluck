# Copy to deploy/.env on the VPS. NEVER commit the real file.
PLUCK_DOMAIN=example.nl
# Long random value, e.g. `openssl rand -hex 24`. It is the credential of the front door.
PLUCK_SECRET=change-me
# Optional: 0 = no per-consumer limit (no donor value exists to default to).
PLUCK_RATE_LIMIT_PER_MINUTE=0
